;;; org-roam-catalog-settings-test.el --- Catalog export tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'json)
(defvar org-roam-directory nil)
(load (expand-file-name "../../settings/org-roam-catalog-settings.el"
                        (file-name-directory load-file-name)) nil t)

(ert-deftest lmoneda/catalog-exports-relative-org-nodes-only ()
  (let* ((root (make-temp-file "desktop-export-test-" t))
         (org-roam-directory (expand-file-name "roam" root))
         (lmoneda/org-roam-catalog-directory (expand-file-name "catalog" root))
         (original-require (symbol-function 'require))
         (syncs 0))
    (unwind-protect
        (progn
          (make-directory org-roam-directory)
          (cl-letf (((symbol-function 'require)
                     (lambda (feature &rest args)
                       (if (eq feature 'org-roam) t
                         (apply original-require feature args))))
                    ((symbol-function 'org-roam-db-sync)
                     (lambda (&rest _) (cl-incf syncs)))
                    ((symbol-function 'org-roam-db-query)
                     (lambda (query &rest _)
                       (cond
                        ((equal query [:select [node-id alias] :from aliases])
                         '(("file-id" "Alternative title")))
                        ((equal query [:select [node-id ref] :from refs :where (= type "cite")])
                         '(("heading-id" "paper2026")))
                        (t (list
                          (list "file-id" "Title" (expand-file-name "note.org" org-roam-directory) 0)
                          (list "heading-id" "Heading" (expand-file-name "note.org" org-roam-directory) 1)
                          (list "boox-id" "BOOX" (expand-file-name "roam-boox/write.org" org-roam-directory) 0)
                          (list "pdf-id" "PDF" (expand-file-name "paper.pdf" org-roam-directory) 0)
                          (list "outside-id" "Outside" (expand-file-name "outside.org" root) 0)))))))
            (let* ((target (lmoneda/org-roam-export-desktop-catalog))
                   (data (with-temp-buffer (insert-file-contents target)
                                          (json-parse-buffer :object-type 'alist :array-type 'list)))
                   (nodes (alist-get 'nodes data)))
              (should (= syncs 0))
              (should (= (alist-get 'version data) 1))
              (should (= (length nodes) 2))
              (should (cl-every (lambda (node) (equal (alist-get 'file node) "note.org")) nodes))
              (should (equal (alist-get 'aliases (car nodes)) '("Alternative title")))
              (should (equal (alist-get 'citekeys (cadr nodes)) '("paper2026")))
              (lmoneda/org-roam-export-desktop-catalog t)
              (should (= syncs 1)))))
      (delete-directory root t))))
